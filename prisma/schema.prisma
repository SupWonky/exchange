generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Media {
  id         String     @id @default(cuid(2))
  name       String?
  url        String
  type       MediaType
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  categoires Category[]
  users      User[]
  messages   Message[]  @relation("MediaToMessage")
  services   Service[]  @relation("MediaToService")
}

model User {
  id              String          @id @default(cuid(2))
  email           String          @unique
  name            String          @default("placeholder")
  description     String?
  balance         Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  avatarId        String?
  skills          String[]
  role            String?
  averageRating   Float           @default(0)
  bio             String?
  completionRate  Float           @default(0)
  ordersCompleted Int             @default(0)
  repeatBuyers    Float           @default(0)
  verified        Boolean         @default(false)
  ordersCount     Int             @default(0)
  reviewsCount    Int             @default(0)
  escrows         EscrowAccount[]
  messages        Message[]
  buyerOrders     Order[]         @relation("BuyerOrders")
  sellerOrders    Order[]         @relation("SellerOrders")
  password        Password?
  reviews         Review[]
  services        Service[]
  transactions    Transaction[]
  avatar          Media?          @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  chats           Chat[]          @relation("ChatToUser")
  userInfo        UserInfo?
}

model Chat {
  id           String    @id @default(cuid(2))
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]
  order        Order?
  participants User[]    @relation("ChatToUser")
}

model Message {
  id              String   @id @default(cuid(2))
  content         String
  createdAt       DateTime @default(now())
  read            Boolean  @default(false)
  isSystemMessage Boolean  @default(false)
  senderId        String
  chatId          String
  chat            Chat     @relation(fields: [chatId], references: [id])
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments     Media[]  @relation("MediaToMessage")
}

model Password {
  hash   String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id            String        @id @default(cuid(2))
  title         String
  slug          String
  description   String?
  requiredInfo  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  views         Int           @default(0)
  status        Status        @default(DRAFT)
  userId        String
  categoryId    String
  pricingTier   PricingTier[]
  reviews       Review[]
  category      Category      @relation(fields: [categoryId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  media         Media[]       @relation("MediaToService")
  serviceInfo   ServiceInfo?
}

model PricingTier {
  id          String              @id @default(cuid(2))
  variant     PricingVariant      @default(BASIC)
  price       Int
  duration    Int
  volume      String
  description String?
  serviceId   String
  orders      Order[]
  service     Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  options     PricingTierOption[]

  @@unique([variant, serviceId])
}

model PricingTierOption {
  name          String
  type          OptionType
  stringValue   String?
  booleanValue  Boolean?
  pricingTierId String
  pricingTier   PricingTier @relation(fields: [pricingTierId], references: [id], onDelete: Cascade)

  @@unique([name, pricingTierId])
}

model Transaction {
  id              String            @id @default(cuid(2))
  amount          Int
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  reference       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  userId          String
  orderId         String?
  escrowAccountId String?
  escrowFee       Int?
  releaseDueDate  DateTime?
  disputeReason   String?
  escrowAccount   EscrowAccount?    @relation(fields: [escrowAccountId], references: [id])
  order           Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EscrowAccount {
  id              String        @id @default(cuid(2))
  balance         Int           @default(0)
  status          EscrowStatus  @default(HELD)
  releaseDueDate  DateTime?
  disputeDeadline DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orderId         String        @unique
  userId          String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
}

model Order {
  id            String         @id @default(cuid(2))
  status        OrderStatus
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  pricingTierId String?
  buyerId       String
  sellerId      String
  chatId        String?        @unique
  escrowAccount EscrowAccount?
  buyer         User           @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  chat          Chat?          @relation(fields: [chatId], references: [id])
  pricingTier   PricingTier?   @relation(fields: [pricingTierId], references: [id])
  seller        User           @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
}

model Review {
  id        String   @id @default(cuid(2))
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  serviceId String
  recommend Boolean
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String     @id @default(cuid(2))
  name      String
  slug      String     @unique
  path      String
  url       String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parentId  String?
  imageId   String?
  image     Media?     @relation(fields: [imageId], references: [id])
  parent    Category?  @relation("ChildrenCategories", fields: [parentId], references: [id])
  children  Category[] @relation("ChildrenCategories")
  services  Service[]
}

view ServiceInfo {
  id           String
  serviceId    String  @unique
  title        String?
  description  String?
  requiredInfo String?
  reviewCount  BigInt
  service      Service @relation(fields: [serviceId], references: [id])
}

view UserInfo {
  userId           String  @unique
  reviewCount      Int
  reviewPositive   Int
  reviewNegative   Int
  orderQueue       Int
  orderCompleted   Int
  orderCanceled    Int
  repeatBuyerRatio Float
  user             User    @relation(fields: [userId], references: [id])
}

enum MediaType {
  IMAGE
  MOVIE
  OTHER
}

enum Status {
  DRAFT
  PUBLISHED
}

enum PricingVariant {
  BASIC
  STANDARD
  BUSINESS
}

enum OptionType {
  STRING
  BOOLEAN
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELED
}

enum TransactionType {
  ESCROW_HOLD
  ESCROW_RELEASE
  ESCROW_REFUND
  ESCROW_FEE
  DEPOSIT
  WITHDRAWAL
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}
